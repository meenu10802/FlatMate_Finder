{
  "name": "Claude Code Pro Environment",
  "image": "://microsoft.com",
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && mkdir -p ~/.claude && echo \"$CLAUDE_CREDENTIALS\" > ~/.claude/.credentials.json && chmod 600 ~/.claude/.credentials.json",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  }
}
